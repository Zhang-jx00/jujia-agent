# 依赖与构建产物
node_modules/
dist/
out/
build/
*.tsbuildinfo

# 测试与覆盖率
coverage/
.vitest/

# Python 字节码缓存：scripts/ 下的工具脚本跑一次就会生成，不该入库
# （此前只写在 cleanup.py 的清理清单里，没写进 .gitignore —— 别人跑一次脚本就可能把它 add 进来）
__pycache__/
*.py[cod]

# 本地回收站（cleanup.py 使用）
.trash/

# 运行时数据（Electron userData 若落在仓库内）
JuJiaData/

# 日志与临时文件
*.log
npm-debug.log*
*.tmp
*.temp
_generated-*.md
# electron-vite 构建时留下的临时配置（带毫秒时间戳；外部审查 T12 清掉的正是这批）
electron.vite.config.*.mjs

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 环境变量（含密钥，禁止入库）
.env
.env.local
.env.*.local

# 打包产物（体积大，通过 GitHub Release 分发，不入库）
apps/desktop/release/

# 测试与临时数据（统一落项目内，不写 C 盘）
.tmp/
# 取证文件（T36：cleanup 不收、路径长期有效；内容仍要抄进台账）
.evidence/
.workbuddy-tmp-*
