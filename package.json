{
  "name": "jujia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "俱佳Agent — 面向 Windows 的个人桌面 Agent（含无限画布工作流、内置浏览器、多模态能力门控）",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @jujia/desktop",
    "build": "npm run build --workspace @jujia/desktop",
    "smoke": "npm run smoke --workspace @jujia/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "clean": "node -e \"console.log('使用 python scripts/cleanup.py --apply 执行项目清理')\"",
    "perf": "npm run perf --workspace @jujia/desktop",
    "setup:terminal": "npm i -w @jujia/desktop node-pty @xterm/xterm @xterm/addon-fit",
    "check:pty": "node apps/desktop/scripts/check-pty.mjs",
    "license:check": "node apps/desktop/scripts/license-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zhang-jx00/jujia-agent.git"
  },
  "homepage": "https://github.com/Zhang-jx00/jujia-agent#readme",
  "bugs": {
    "url": "https://github.com/Zhang-jx00/jujia-agent/issues"
  },
  "author": "Zhang-jx00 and 俱佳Agent contributors"
}
