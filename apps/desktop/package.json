{
  "name": "@jujia/desktop",
  "version": "0.43.0",
  "private": true,
  "description": "俱佳Agent：本地优先的 Windows 个人 Agent（副作用动作需确认，数据不出本机）",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "perf": "electron-vite build && node scripts/run-electron.mjs --perf",
    "smoke": "electron-vite build && node scripts/run-electron.mjs --smoke",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "icon": "node scripts/make-icon.mjs",
    "e2e": "electron-vite build && node scripts/e2e-ui.mjs",
    "app": "electron-vite build && node scripts/run-electron.mjs"
  },
  "dependencies": {
    "@jujia/agent-core": "*",
    "@jujia/shared": "*",
    "@jujia/shared-ipc": "*",
    "@jujia/ui-tokens": "*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.4.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.4",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.jujia.agent",
    "productName": "JujiaAgent",
    "copyright": "Copyright © 2026 俱佳Agent",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/node-pty/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "俱佳Agent",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "uninstallDisplayName": "俱佳Agent ${version}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "electronVersion": "44.4.2",
    "npmRebuild": false
  },
  "author": {
    "name": "Zhang-jx00",
    "email": "zhangjx00@users.noreply.github.com"
  },
  "license": "MIT"
}
